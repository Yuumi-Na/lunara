# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง

# GOOGLE_CLIENT_ID: Client ID จาก Google Cloud Console สำหรับ Google Sign-In
# สร้างที่ https://console.cloud.google.com/apis/credentials (OAuth client ID -> Web application)
# ต้องเพิ่ม Authorized JavaScript origins: http://localhost:3000 (และโดเมนจริงตอน deploy)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# ADMIN_EMAILS: อีเมลที่มีสิทธิ์เข้าหลังร้าน คั่นด้วย , เพื่อเพิ่มผู้ดูแล
ADMIN_EMAILS="natpapattep@gmail.com"

# SESSION_SECRET: คีย์ลับยาว ๆ สำหรับลงลายเซ็น Session Cookie
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# LUNARA_STORAGE_DIR (ไม่บังคับ): โฟลเดอร์เก็บไฟล์ฐานข้อมูล SQLite (ค่าเริ่มต้น ./storage)
# LUNARA_STORAGE_DIR="./storage"

# GEMINI_API_KEY / APP_URL: ใช้เมื่อรันบน AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ADMIN_USERNAME / ADMIN_PASSWORD_HASH: Admin ล็อกอินด้วยชื่อผู้ใช้ + รหัสผ่าน (ลูกค้าทั่วไปใช้ Google เท่านั้น)
# ห้ามใส่รหัสผ่านตรง ๆ — ตั้งค่าด้วยคำสั่ง:  npm run admin:password -- <username> <password>
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD_HASH="scrypt$16384$..."
